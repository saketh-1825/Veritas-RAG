# Veritas RAG - Backend Environment Variables
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# LLM Providers (Optional for local testing, required for live LLM generation & evaluation)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# MongoDB Database (Optional: falls back to local file-based database if unreachable)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="ragdb"

# JWT Security
SECRET_KEY="veritas-rag-super-secret-jwt-encryption-key-32chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Upload Directory
UPLOAD_DIR="uploads"

# Vector Store (Pinecone)
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="rag-index"

# Embedding Configurations
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="models/gemini-embedding-001"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
